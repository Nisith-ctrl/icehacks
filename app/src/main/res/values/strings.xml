<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SuuS</string>
    <string name="service_description">SuuS reads the controls on screen and taps, types and scrolls for you when you ask by voice. It acts only in Gmail, Calendar, Chrome and Messages, and asks before anything is submitted or sent.</string>

    <!-- Setup screen -->
    <string name="hero_eyebrow_setup">Your hands-free helper</string>
    <string name="hero_eyebrow_profile">Set once, used everywhere</string>
    <string name="hero_eyebrow_memory">Your choices, your control</string>
    <string name="setup_progress_count">%1$d/%2$d</string>
    <string name="setup_progress_label">steps done</string>
    <string name="setup_subtitle">Set up once. After that, just say what you need.</string>
    <string name="setup_progress">%1$d of %2$d steps done</string>
    <string name="setup_all_done_title">You\'re ready</string>
    <string name="setup_all_done_body">Say \"SuuS\", then what you want. For example: \"SuuS, find the library workshop invite and register me.\" Say \"Stop\" at any time.</string>
    <string name="setup_privacy">SuuS only acts in Gmail, Calendar, Chrome and Messages, and always asks you before it submits or sends anything.</string>
    <string name="section_setup">Setup</string>
    <string name="section_more">More</string>
    <string name="step_next">Do this next</string>
    <string name="step_number_next">Step %1$d, do this next</string>
    <string name="step_done">Done</string>
    <string name="step_not_done">Not done yet</string>
    <string name="step_number_done">Step %1$d, done</string>
    <string name="step_number_not_done">Step %1$d, not done yet</string>

    <string name="step_service_title">Turn on SuuS</string>
    <string name="step_service_detail">This lets the app read the screen and tap for you. In the list that opens, choose SuuS (it may be under Installed apps), then switch it on.</string>
    <string name="step_service_action">Open Accessibility settings</string>

    <string name="step_mic_title">Allow the microphone</string>
    <string name="step_mic_detail">So the app can hear \"SuuS\" and your answers. Choose \"While using the app\".</string>
    <string name="step_mic_action">Allow microphone</string>

    <string name="step_calendar_title">Allow the calendar</string>
    <string name="step_calendar_detail">So the app can pick times that don\'t clash with your events. It only reads your calendar.</string>
    <string name="step_calendar_action">Allow calendar</string>

    <string name="step_photos_title">Allow photos</string>
    <string name="step_photos_detail">So the app can find the photo you ask for. Choose \"Allow all\".</string>
    <string name="step_photos_action">Allow photos</string>

    <string name="step_notifications_title">Allow notifications</string>
    <string name="step_notifications_detail">So the app can show that it is listening.</string>
    <string name="step_notifications_action">Allow notifications</string>

    <string name="step_profile_title">Tell SuuS about you</string>
    <string name="step_profile_detail">Your name, email and phone, so SuuS can fill in forms for you. You only do this once. Anything you skip, SuuS asks for by voice the first time and remembers.</string>
    <string name="step_profile_action">Add your details</string>
    <string name="step_profile_again">Change your details</string>

    <string name="step_wake_title">Check that it hears you</string>
    <string name="step_wake_detail">Press the button, then say \"SuuS\" (it sounds like \"soose\"). The app should answer \"Yes?\" out loud.</string>
    <string name="step_wake_action">Start the check</string>
    <string name="step_wake_again">Check again</string>
    <string name="wake_listening">Listening for 30 seconds. Say \"SuuS\".</string>
    <string name="wake_heard">It heard you.</string>
    <string name="wake_not_heard">It didn\'t hear \"SuuS\". Move closer to the phone and try again.</string>
    <string name="wake_needs_setup">Finish the steps above first: turn on SuuS and allow the microphone.</string>

    <string name="open_memory">What I remember</string>
    <string name="open_memory_body">See and remove the choices SuuS saved for you.</string>
    <string name="open_memory_action">Open What I remember</string>
    <string name="debug_note">Debug build: adb hooks are active while the service is on.</string>

    <!-- About you -->
    <string name="profile_title">About you</string>
    <string name="profile_intro">SuuS uses these to fill in forms for you, every time.</string>
    <string name="profile_name">Your name</string>
    <string name="profile_email">Email</string>
    <string name="profile_phone">Phone</string>
    <string name="profile_not_set">Not set yet</string>
    <string name="profile_save">Save</string>
    <string name="profile_saved">Saved. SuuS will use these from now on.</string>
    <string name="profile_bad_email">That email doesn\'t look right. Check it and save again.</string>
    <string name="profile_voice_hint">Prefer talking? Leave a box empty and SuuS will ask for it out loud the first time a form needs it, then save it here.</string>

    <!-- Appearance -->
    <string name="theme_title">Appearance</string>
    <string name="theme_body">Pick the colours that are easiest for you to read.</string>
    <string name="theme_system">Match my phone</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>
    <string name="theme_selected">%1$s, selected</string>
    <string name="theme_choose">Use %1$s</string>

    <!-- "What I remember" screen -->
    <string name="memory_title">What I remember</string>
    <string name="memory_intro">The choices you asked SuuS to remember, so it doesn\'t ask again.</string>
    <string name="memory_empty_title">Nothing saved yet</string>
    <string name="memory_empty_body">SuuS only remembers what you tell it to. When it asks you a question, add \"remember that\" to your answer. For example: \"Email. Remember that for event signups.\"</string>
    <string name="memory_voice_hint">You can also ask out loud: \"SuuS, what do you remember?\" or \"SuuS, forget my event signup choice.\"</string>
    <plurals name="memory_count">
        <item quantity="one">%1$d saved choice</item>
        <item quantity="other">%1$d saved choices</item>
    </plurals>
    <string name="memory_label">%1$s · %2$s</string>
    <string name="memory_forget_all">Forget everything</string>
    <string name="memory_forget_all_title">Forget everything?</string>
    <string name="memory_forget_all_body">All saved choices will be removed. SuuS will ask you again next time.</string>
    <string name="memory_forget_all_yes">Forget everything</string>
    <string name="memory_forgot_all">Everything forgotten</string>
