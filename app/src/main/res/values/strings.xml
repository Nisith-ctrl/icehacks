    <string name="memory_remove_described">Remove: %1$s</string>
    <string name="memory_confirm_title">Remove this?</string>
    <string name="memory_confirm_body">\"%1$s\" will be forgotten. SuuS will ask you again next time.</string>
    <string name="memory_confirm_yes">Remove it</string>
    <string name="memory_confirm_no">Keep it</string>
