    <!-- "What I remember" screen -->
    <string name="memory_title">What I remember</string>
    <string name="memory_intro">The choices you asked SuuS to remember, so it doesn\'t ask again.</string>
    <string name="memory_empty_title">Nothing saved yet</string>
    <string name="memory_empty_body">SuuS only remembers what you tell it to. When it asks you a question, add \"remember that\" to your answer. For example: \"Email. Remember that for event signups.\"</string>
    <string name="memory_voice_hint">You can also ask out loud: \"SuuS, what do you remember?\" or \"SuuS, forget my event signup choice.\"</string>
