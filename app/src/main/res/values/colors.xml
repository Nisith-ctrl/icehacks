<?xml version="1.0" encoding="utf-8"?>
<!-- Light theme, from guru's SuuS robot and speech bubble: cream, mint, dark green.
     Text on its background is at least 4.5:1; most pairs are 7:1 or better. -->
<resources>
    <color name="suus_background">#FBF6EF</color>
    <color name="suus_surface">#FFFFFF</color>
    <color name="suus_surface_alt">#F1ECE3</color>
    <color name="suus_outline">#DDD5C7</color>
    <color name="suus_text">#13241A</color>
    <color name="suus_text_secondary">#4A5A50</color>
    <color name="suus_primary">#1D6A43</color>
    <color name="suus_on_primary">#FFFFFF</color>
    <color name="suus_primary_soft">#DCEFE2</color>
    <color name="suus_on_primary_soft">#12472D</color>
    <color name="suus_ok">#1B7A3E</color>
    <color name="suus_on_ok">#FFFFFF</color>
    <color name="suus_ok_soft">#DDF3E4</color>
    <color name="suus_pending">#6B4E00</color>
    <color name="suus_pending_soft">#FFEFC2</color>
    <color name="suus_danger">#B42318</color>
    <color name="suus_on_danger">#FFFFFF</color>
    <color name="suus_hero_start">#0A2913</color>
    <color name="suus_hero_end">#22603F</color>
    <color name="suus_on_hero">#FDF6ED</color>
    <color name="suus_icon_background">#FDF6ED</color>
    <!-- Hero ribbon (Stripe-style flowing gradient, in the robot's own colours: antenna amber, coral, mint, green).
         Decorative only: no text sits on it. -->
    <color name="suus_ribbon_1">#F6C453</color>
    <color name="suus_ribbon_2">#F08A6B</color>
    <color name="suus_ribbon_3">#7FC8A0</color>
    <color name="suus_ribbon_4">#1D6A43</color>
    <!-- Second half of a two-tone headline: 6.1:1 on suus_surface. -->
    <color name="suus_headline_accent">#2F6E4E</color>
    <!-- Tint for card shadows, so they read as soft green rather than grey. -->
    <color name="suus_shadow">#1D6A43</color>
</resources>
